# Modelo de configuração. Copie para ".env" e preencha. O arquivo .env NUNCA deve ser versionado.
# Gere valores aleatórios com: openssl rand -hex 32

# Banco de dados (use só letras e números na senha, para não quebrar a URL de conexão)
POSTGRES_DB=decida_voto
POSTGRES_USER=decida_voto
POSTGRES_PASSWORD=

# Endereço público do site, sem barra no final (ex.: https://www.seudominio.com.br)
APP_ORIGIN=

# Segredos com pelo menos 32 caracteres aleatórios
FORM_TOKEN_SECRET=
RATE_LIMIT_SECRET=

# Acesso ao painel /admin. Gere o hash com: npm run admin:hash
# (ou, sem Node local: docker compose run --rm -it migrate npm run admin:hash)
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Grupos com menos participações que isso ficam ocultos no painel (mínimo 5)
PRIVACY_MIN_GROUP=10
# Tempo mínimo (segundos) entre iniciar o questionário e enviar
FORM_MIN_SECONDS=15

# Porta local da aplicação (o Nginx faz o proxy para 127.0.0.1:APP_PORT)
APP_PORT=3000

# Backups: dias de retenção dos arquivos em ./backups
BACKUP_RETENTION_DAYS=14
# Data (AAAA-MM-DD) após a qual as participações são excluídas automaticamente
PARTICIPACOES_EXCLUIR_APOS=2027-03-31

# Proxy público. Com Nginx, deixe como está. Com Cloudflare Tunnel (portas 80/443 já ocupadas na VPS):
#   COMPOSE_PROFILES=cloudflare, TRUSTED_IP_HEADER=cf-connecting-ip e o token do túnel abaixo.
# O token é um segredo: nunca o envie por chat ou e-mail.
COMPOSE_PROFILES=
TRUSTED_IP_HEADER=x-real-ip
CLOUDFLARE_TUNNEL_TOKEN=
